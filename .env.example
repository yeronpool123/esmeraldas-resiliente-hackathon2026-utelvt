# PostgreSQL/PostGIS y autenticacion. Cambia las contrasenas localmente.
POSTGRES_DB=esmeraldas_resiliente
POSTGRES_USER=esmeraldas_app
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LOCAL
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://esmeraldas_app:CAMBIAR_POR_UNA_CLAVE_LOCAL@localhost:5433/esmeraldas_resiliente

# Genera secretos diferentes con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
JWT_REFRESH_SECRET=REEMPLAZAR_POR_OTRO_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS

# Identidades y claves institucionales distintas; no usar la misma clave para ambos roles.
ADMIN_EMAIL=admin@esmeraldas.gob.ec
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LOCAL_DE_12_A_72_BYTES
COE_EMAIL=operador.coe@esmeraldas.gob.ec
COE_PASSWORD=CAMBIAR_POR_OTRA_CLAVE_LOCAL_DE_12_A_72_BYTES

# URL del frontend permitida por CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE_ENABLED=false
